# ==============================================================================
# Project TraceX - Production Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# MongoDB Database Connection (Must be rotated for production deployment)
MONGODB_URI=
MONGODB_DATABASE=monitor

# Security & Authentication (JWT Secret must be high-entropy, e.g. openssl rand -hex 32)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public-Facing Endpoints (Used for client links, CORS, and notifications)
API_BASE_URL=
WS_BASE_URL=

# Evidence Vault Secure Storage Path
UPLOAD_DIR=./evidence_vault
MAX_UPLOAD_SIZE_BYTES=104857600

# CORS Allowed Origins (Comma-separated exact origins, NO wildcards in production)
ALLOWED_ORIGINS=
