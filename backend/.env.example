# ==============================================================================
# Project TraceX - Backend Environment Configuration Template (.env.example)
# Note: Keep real production credentials outside source code.
# For Vercel or deployment servers, populate these in project settings.
# ==============================================================================

# Server Network Configuration
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# MongoDB Database Connection String
MONGODB_URI=
MONGODB_DATABASE=tracex_forensics

# Baseline Administrator Authentication (Server-side Only)
TRACEX_ADMIN_USERNAME=
TRACEX_ADMIN_PASSWORD_HASH=
TRACEX_ADMIN_PASSWORD=

# Security & Cryptographic Tokens (Generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public-Facing Endpoints
API_BASE_URL=
WS_BASE_URL=

# CORS Allowed Origins (Never use wildcard '*' in production)
# Production: ALLOWED_ORIGINS=https://tracex-tau.vercel.app
# Local Dev:   ALLOWED_ORIGINS=http://localhost:5500,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_ORIGINS=

# Optional Map / Third-Party Services
GOOGLE_MAPS_API_KEY=
MAP_API_KEY=

# Evidence Vault Secure Storage Path
UPLOAD_DIR=./evidence_vault
MAX_UPLOAD_SIZE_BYTES=104857600
