# ==============================================================================
# TraceX — Unified Environment Configuration Reference (.env.example)
# Digital Forensics and Authorized Telemetry Platform
# NOTE: DO NOT COMMIT REAL CREDENTIALS. Populate these in your environment / Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND DASHBOARD (Vercel Project Environment Variables)
# ------------------------------------------------------------------------------
# Production backend HTTPS endpoint for dashboard REST API requests
VITE_API_BASE_URL=https://api.yourdomain.com

# Production WebSocket endpoint for live SOC telemetry stream
VITE_WS_URL=wss://api.yourdomain.com/ws/investigation

# ------------------------------------------------------------------------------
# 2. BACKEND API ENGINE (FastAPI / Motor / JWT / Evidence Vault)
# ------------------------------------------------------------------------------
# Application Runtime Environment (production | development | staging)
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# MongoDB Database Connection String (Use external persistent cluster, e.g., Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=tracex_forensics

# Cryptographic Token Signing Key (Min 32 characters high-entropy string: openssl rand -hex 32)
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Public Canonical URLs
API_BASE_URL=https://api.yourdomain.com
WS_BASE_URL=wss://api.yourdomain.com

# Evidence Vault Local / Volume Storage Directory
UPLOAD_DIR=./evidence_vault
MAX_UPLOAD_SIZE_BYTES=104857600

# CORS Allowed Origins (Comma-separated exact origins, NO wildcards '*' in production)
# Example: https://tracex.vercel.app,https://tracex-investigation.vercel.app
ALLOWED_ORIGINS=https://tracex.vercel.app

# ------------------------------------------------------------------------------
# 3. ANDROID APPLICATION (Gradle Build Properties / CI Environment)
# ------------------------------------------------------------------------------
# Production backend URL compiled into the APK or supplied via Gradle -PTRACEX_SERVER_URL
TRACEX_SERVER_URL=https://api.yourdomain.com
